doctype html
html(lang="en")
  head
    title Week 12 - #{student ? "Edit" : "Add"} Student
    link(rel="stylesheet", href="/style.css")
  body
    h1= student ? "Edit Student" : "Add Student"
    form(action=student ? `/students/${student.id}` : "/students", method="POST")
      label(for="name") Name
      input(type="text", id="name", name="name", value=student ? student.name : "", required)
      label(for="email") Email
      input(type="email", id="email", name="email", value=student ? student.email : "", required)
      label(for="program") Program
      input(type="text", id="program", name="program", value=student ? student.program : "", required)
      button(type="submit") Save
    a(href="/") Back to list
